<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>DIAB_MB_Timecard_Approvers</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>DIAB_MB_AdjustedTimecard_for_past_period__c</field>
        <field>DIAB_MB_AdjustedTimecard_forAdvanceEntry__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>pse__Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Requeat to Approver</label>
        <name>Requeat_to_Approver</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Period_Approval_Head</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Delivery_Head</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>pse__Timecard_Header__c.DIAB_MB_Period_Approval__c</field>
                <operation>equals</operation>
                <value>PM/LM Approval (Past Period)</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Head of Delivery Approval</label>
        <name>Head_of_Delivery_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Status_update_Reject</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_1</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Period_Approval_CAO</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Status_update_Approve</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>CAO_Approval</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>pse__Timecard_Header__c.DIAB_MB_Period_Approval__c</field>
                <operation>equals</operation>
                <value>Head of Delivery Approval</value>
            </criteriaItems>
        </entryCriteria>
        <label>CAO Approval</label>
        <name>CAO_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Period_Approval_CAO_0</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Status_Reject</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval process for past period timecards</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 2) AND 4 AND (3 OR 5)</booleanFilter>
        <criteriaItems>
            <field>pse__Timecard_Header__c.pse__Approved__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>pse__Timecard_Header__c.pse__Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </criteriaItems>
        <criteriaItems>
            <field>pse__Timecard_Header__c.DIAB_MB_Period_Approval__c</field>
            <operation>equals</operation>
            <value>PM/LM Approval (Past Period)</value>
        </criteriaItems>
        <criteriaItems>
            <field>pse__Timecard_Header__c.DIAB_MB_AdjustedTimecard_for_past_period__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>pse__Timecard_Header__c.DIAB_MB_Period_Approval__c</field>
            <operation>equals</operation>
            <value>Head of Delivery Approval</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>PSA_Timecard_Approved_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PSA_Timecard_IFF_Truee</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>PSA_Timecard_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Timecard_Approval_Datee</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_Final</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>PSA_Timecard_Submitted_TRUE0</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>TTimecard_Status_Changed_to_Summited</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Past Period approval</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
