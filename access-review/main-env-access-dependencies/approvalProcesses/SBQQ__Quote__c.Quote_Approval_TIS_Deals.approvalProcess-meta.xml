<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>SBQQ__Account__c</field>
        <field>SBQQ__Type__c</field>
        <field>Name</field>
        <field>Owner</field>
        <field>SBQQ__SubscriptionTerm__c</field>
        <field>SBQQ__PaymentTerms__c</field>
        <field>SBQQ__Opportunity2__c</field>
        <field>SBQQ__Notes__c</field>
        <field>SBQQ__CustomerDiscount__c</field>
        <field>SBQQ__ExpirationDate__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Alert_Owner_Quote_Approved_TIS1</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Status_Pending_Compliance_Approval_TIS1</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>GM_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>For TIS Opportunities.   Approval results in status &quot;Pending Approval - Compliance&quot;</description>
        <label>GM</label>
        <name>GM_TIS</name>
        <rejectionActions>
            <action>
                <name>Alert_Owner_Quote_Rejected_1</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Alert_Owner_Quote_Approved_TIS2</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Compliance_Approver</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Compliance</label>
        <name>Compliance</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Alert_Everyone_Quote_Rejected_TIS</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Approval process for quotes where Opportunity Type : RS-Rev Share or Rev Rec &amp;&amp; Account Name : Telecom Italia (Sparkle SpA)</description>
    <emailTemplate>unfiled$public/visualForceQuoteApprovalRequest</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(Account_Name__c == &quot;Telecom Italia (Sparkle SpA)&quot;,

ISPICKVAL(SBQQ__Opportunity2__r.Type ,&quot;RS-Rev Share or Rec Rev&quot;))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Primary_Quote_Checkbox_is_True1</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Approved_TIS</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_Declined_TIS</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_Pending_Approval_GM_TIS</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Quote Approval TIS Deals</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
