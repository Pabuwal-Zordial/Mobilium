<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>divya.agarwal@sfdc.mobileum.com</submitter>
        <type>user</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>revenue@sfdc.mobileum.com</submitter>
        <type>user</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Amount</field>
        <field>Type</field>
        <field>SBQQ__PrimaryQuote__c</field>
        <field>CloseDate</field>
        <field>OLD_Accepted_By__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>revenue@sfdc.mobileum.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Submit opportunity to Finance for approval.</description>
        <label>Finance Approval</label>
        <name>Finance_Approval</name>
    </approvalStep>
    <description>After a Quote is approved, Account Manager or General Manager collects documentation and &quot;Self Declares&quot; that all info is in system and ready to submit for Finance approval.</description>
    <emailTemplate>unfiled$public/Opportunity_Approval_Request_LetterHead</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>(Quote_Approved__c =true &amp;&amp;  (ISPICKVAL(Opportunity_Approval_Status__c ,&apos;Approved&apos;)|| ISPICKVAL(Opportunity_Approval_Status__c ,&apos;Approved - 2nd&apos;)) &amp;&amp;  Hw_Purchase_Request__c =true &amp;&amp;  HW_purchase_approval_status__c =&apos;Approved&apos;) || (Quote_Approved__c =true &amp;&amp; (ISPICKVAL(Opportunity_Approval_Status__c ,&apos;Approved&apos;)|| ISPICKVAL(Opportunity_Approval_Status__c ,&apos;Approved - 2nd&apos;)) &amp;&amp;  Hw_Purchase_Request__c =false)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Alert_Everyone_Opportunity_Approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Finance_Approved_Checkbox</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Commission_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Forecast_Category</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Opportunity_Status_as_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Oppty_Stage_to_Won</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alert_Everyone_Opportunity_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Clear_Accept_Self_Declaration</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Accepted_By</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Clear_Accepted_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Opportunity_Status_as_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_Opportunity_Status</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Non MFS Opportunity Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
