<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Expected_Deal_Value_USD__c</field>
        <field>Expected_Hardware_Cost_USD__c</field>
        <field>Justification__c</field>
        <field>Opportunity__c</field>
        <field>PO_Expected_By__c</field>
        <field>Hardware_Resalability__c</field>
        <field>Risk_of_Deal_Cancellation__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Alert_for_HW_Purchase_2nd_level_approval</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_status_to_Approved_1st_level</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>sridhar.b@sfdc.mobileum.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Hardware_Purchase_Request__c.Approval_Status__c</field>
                <operation>equals</operation>
                <value>Pending</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ripu.singh@sfdc.mobileum.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Hardware_Purchase_Request__c.Approval_Status__c</field>
                <operation>equals</operation>
                <value>Approved-1st Level</value>
            </criteriaItems>
        </entryCriteria>
        <label>Second level approval</label>
        <name>Second_level_approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>unfiled$public/Opportunity_HW_Purchase_Approval_Request_LetterHead</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
        <criteriaItems>
            <field>Opportunity.Hw_Purchase_Request__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Hardware_Purchase_Request__c.Approval_Status__c</field>
            <operation>equals</operation>
            <value>Not Submitted,Recalled</value>
        </criteriaItems>
        <criteriaItems>
            <field>Hardware_Purchase_Request__c.Expected_Hardware_Cost_USD__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Hardware_Purchase_Request__c.Hardware_Resalability__c</field>
            <operation>equals</operation>
            <value>High,Medium,Low</value>
        </criteriaItems>
        <criteriaItems>
            <field>Hardware_Purchase_Request__c.Justification__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Hardware_Purchase_Request__c.Risk_of_Deal_Cancellation__c</field>
            <operation>equals</operation>
            <value>High,Medium,Low</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Alert_for_HW_Purchase_approval</name>
            <type>Alert</type>
        </action>
        <action>
            <name>update_Hw_request_approval_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Alert_for_HW_Purchase_rejection</name>
            <type>Alert</type>
        </action>
        <action>
            <name>update_Hw_request_approval_rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>update_status_to_pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Hw Purchase Request Approval process</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Alert_for_HW_Purchase_recalled</name>
            <type>Alert</type>
        </action>
        <action>
            <name>update_Hw_request_approval_recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
