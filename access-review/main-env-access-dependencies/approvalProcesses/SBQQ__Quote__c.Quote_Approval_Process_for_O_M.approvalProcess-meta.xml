<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Status_Pending_Approval_Compliance_MRQ</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>amrita.desai@sfdc.mobileum.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <description>Finance Approval Rejection for O&amp;M Servies</description>
        <label>O&amp;M Services Approval</label>
        <name>O_M_Services_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Alert_Everyone_Quote_Approved</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Compliance_Approver</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Compliance</description>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.SBQQ__Status__c</field>
                <operation>equals</operation>
                <value>Pending Approval - Compliance</value>
            </criteriaItems>
        </entryCriteria>
        <label>Compliance</label>
        <name>Compliance</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Quote Approval Process were only O&amp;M products exists in primary quote and no SCM approval required</description>
    <emailTemplate>unfiled$public/visualForceQuoteApprovalRequest</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND  2 AND (3 OR 4) AND 5 AND 6 AND 7</booleanFilter>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__Primary__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.O_M_Services_Booking__c</field>
            <operation>notEqual</operation>
            <value>USD 0</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.O_M_Services_Margin__c</field>
            <operation>lessThan</operation>
            <value>30</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.O_M_Services_Margin__c</field>
            <operation>greaterThan</operation>
            <value>70</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.X3P_Hardware_Software_Booking__c</field>
            <operation>equals</operation>
            <value>USD 0</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.X3P_Services_Booking__c</field>
            <operation>equals</operation>
            <value>USD 0</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.X3P_Maintenance_Booking__c</field>
            <operation>equals</operation>
            <value>USD 0</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Primary_Quote_Checkbox_is_True1</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Compliance_Approval_date</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Quote_Status_Declined</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending_Approval_O_M_Services</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Quote Approval Process for O&amp;M</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
