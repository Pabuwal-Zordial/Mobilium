    <description>Approval process for all quotes where MFS == TRUE &amp;&amp; Oppty Type == MR-Maintenance Renewal

***NOTE: It&apos;s critcal this process comes before Quote Approval, as this is to reroute MFS + MR specifically. Approvals containing MFS without MR remain same as standard approvals.</description>
    <emailTemplate>unfiled$public/visualForceQuoteApprovalRequest</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>SBQQ__Opportunity2__r.OLD_Accept_Self_Declaration__c ==FALSE
&amp;&amp;
 SBQQ__Opportunity2__r.LoE_Attached__c == TRUE
&amp;&amp;
 SBQQ__Opportunity2__r.OLD_Proposal_Attached__c == TRUE
&amp;&amp;
 SBQQ__Opportunity2__r.MFS_Opportunity__c == TRUE
&amp;&amp;
 ISPICKVAL(SBQQ__Opportunity2__r.Type ,&quot;MR-Maintenance Renewal&quot;)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Primary_Quote_Checkbox_is_True</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Approved_MRQ1</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_Declined</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
