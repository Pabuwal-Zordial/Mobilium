        <name>Clean_Error_Message</name>
        <label>Clean Error Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>PPO_Creation_Error</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <formulaDataType>String</formulaDataType>
                    <formulaExpression>IF(
  ISBLANK({!errorMessage}),
  &quot;An unknown error occurred.&quot;,
  LEFT(
    SUBSTITUTE(
      {!errorMessage},
      &quot;This error occurred when the flow tried to create records: FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;,
      &quot;&quot;
    ),
    FIND(
      &quot;.&quot;,
      SUBSTITUTE(
        {!errorMessage},
        &quot;This error occurred when the flow tried to create records: FIELD_CUSTOM_VALIDATION_EXCEPTION: &quot;,
        &quot;&quot;
      )
    ) + 1
  )
)</formulaExpression>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
