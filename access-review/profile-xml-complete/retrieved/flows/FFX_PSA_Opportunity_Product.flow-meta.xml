                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Is_Services_on_Opportunity</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
