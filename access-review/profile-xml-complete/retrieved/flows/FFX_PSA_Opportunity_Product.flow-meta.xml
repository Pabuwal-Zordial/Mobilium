    <decisions>
        <name>Is_Services_Product</name>
        <label>Is Services Product</label>
        <locationX>512</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No_IsSrvPrd</defaultConnectorLabel>
        <rules>
            <name>Yes_IsSrvPrd</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product2.pse__IsServicesProduct__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Is_Srv_Product_to_TRUE</targetReference>
            </connector>
            <label>Yes_IsSrvPrd</label>
        </rules>
        <rules>
            <name>Billing_type_is_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product2.ffbc__BillingType__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Opp_Product_Billing_Type_equal_to_Product_Billing_Type</targetReference>
            </connector>
            <label>Billing type is not null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Opportunity_is_Added</name>
        <label>Opportunity is Added</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OpportunityId</leftValueReference>
