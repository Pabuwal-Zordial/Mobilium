    <description>Updating the Submitted flag to TRUE when timecard is submitted so that the Timecard is pushed to the Approval Process.</description>
    <environments>Default</environments>
    <formulas>
        <name>For_ProjectTaskName</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!Var_ProjectTaskName}, 1) = &quot;;&quot;,
   LEFT({!Var_ProjectTaskName}, LEN({!Var_ProjectTaskName}) - 1),
   {!Var_ProjectTaskName}
)</expression>
    </formulas>
    <formulas>
        <name>For_TotalHours</name>
        <dataType>String</dataType>
        <expression>{!LooPTaskTime.pse__Project_Task__r.Name} &amp; &quot; &quot; &amp; &quot;(&quot; &amp;TEXT({!LooPTaskTime.pse__Total_Hours__c}) &amp; &quot;)&quot;</expression>
    </formulas>
