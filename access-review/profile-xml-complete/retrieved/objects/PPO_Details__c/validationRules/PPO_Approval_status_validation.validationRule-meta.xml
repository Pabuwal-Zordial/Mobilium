<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PPO_Approval_status_validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(Opportunity__r.PPO_Approval_StatusfromOpp__c=&apos;Approved&apos;)&amp;&amp; NOT( Opportunity__r.PPO_Approval_StatusfromOpp__c=&apos;Rejected&apos;)&amp;&amp;  ISNEW()&amp;&amp;  Opportunity__r.Number_of_PPO__c &gt;0</errorConditionFormula>
    <errorMessage>New PPO can only be created if Previous PPO Approval status is approved or rejected</errorMessage>
</ValidationRule>
