<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled_status_validation</fullName>
    <active>true</active>
    <errorConditionFormula>(ISPICKVAL(PRIORVALUE(  Approval_Status__c ),&apos;Pending&apos;)|| ISPICKVAL(PRIORVALUE(  Approval_Status__c ),&apos;Approved-1st Level&apos;)) &amp;&amp; ISPICKVAL(Approval_Status__c,&apos;Cancelled&apos;)</errorConditionFormula>
    <errorMessage>Can not cancel a Hw request already submitted for approval. Either Recall or Reject it before Cancellation</errorMessage>
</ValidationRule>
