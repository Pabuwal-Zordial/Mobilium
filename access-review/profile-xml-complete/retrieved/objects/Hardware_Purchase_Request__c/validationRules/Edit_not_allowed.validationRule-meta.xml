<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Edit_not_allowed</fullName>
    <active>true</active>
    <errorConditionFormula>(ISPICKVAL(PRIORVALUE( Approval_Status__c ),&apos;Rejected&apos;)||ISPICKVAL(PRIORVALUE( Approval_Status__c ),&apos;Recalled&apos;)) &amp;&amp; (ISCHANGED(Expected_Hardware_Cost_USD__c  ) || ISCHANGED( Name ) ||ISCHANGED( Hardware_Resalability__c ) ||ISCHANGED(Expected_Hardware_Cost_USD__c  )  ||ISCHANGED(Justification__c )||ISCHANGED(Risk_of_Deal_Cancellation__c ))</errorConditionFormula>
    <errorMessage>Can not change anything after  HW request is in Rejected or Recalled Status</errorMessage>
</ValidationRule>
