public without sharing class ApprovalNotificationSender {

    private static final String NOTIF_TYPE_DEV_NAME  = 'Opportunity_Approval_Notification';

    private static final Integer MAX_TITLE  = 80;
    private static final Integer MAX_BODY   = 750;

    public static void sendApprovalRequestToUsers(List<Id> approverIds, Id oppId, String oppName, String level, Map<Id, Id> approverWorkitemIds) {
        if (approverIds == null || approverIds.isEmpty() || oppId == null) return;
        Id notifTypeId = getNotifTypeId();
        if (notifTypeId == null) return;

        String title = truncate('Approval Required: ' + oppName, MAX_TITLE);
        String body  = truncate('Your approval is required for "' + oppName + '". Click to approve or reject.', MAX_BODY);

        for (Id approverId : approverIds) {
            Id targetId = (approverWorkitemIds != null && approverWorkitemIds.containsKey(approverId))
                ? approverWorkitemIds.get(approverId)
                : oppId;
            dispatch(notifTypeId, title, body, targetId, new Set<String>{ String.valueOf(approverId) });
        }
    }

    public static void sendApprovalOutcome(Id oppId, String oppName, Id ownerId, String outcomeType) {
        if (oppId == null) return;
        Id notifTypeId = getNotifTypeId();
        if (notifTypeId == null) return;

        String title;
        String body;

        if (outcomeType == 'L1_APPROVED') {
            title = truncate('Approved - Sent for Next Review: ' + oppName, MAX_TITLE);
            body  = truncate('Approval is complete. "' + oppName + '" has been submitted for the next review.', MAX_BODY);
        } else if (outcomeType == 'L2_APPROVED') {
            title = truncate('Opportunity Approved: ' + oppName, MAX_TITLE);
            body  = truncate('Approval is completed.', MAX_BODY);
        } else {
            title = truncate('Opportunity Rejected: ' + oppName, MAX_TITLE);
            body  = truncate('"' + oppName + '" has been rejected. Please review comments and resubmit if required.', MAX_BODY);
        }

        Set<String> recipients = new Set<String>();
        if (ownerId != null) recipients.add(String.valueOf(ownerId));
        dispatch(notifTypeId, title, body, oppId, recipients);
    }

    private static Id getNotifTypeId() {
        List<CustomNotificationType> types = [
            SELECT Id
            FROM   CustomNotificationType
            WHERE  DeveloperName = :NOTIF_TYPE_DEV_NAME
            LIMIT  1
        ];
        if (types.isEmpty()) {
            System.debug('ApprovalNotificationSender: CustomNotificationType "' + NOTIF_TYPE_DEV_NAME + '" not found — deploy the notification type first.');
            return null;
        }
        return types[0].Id;
    }

    private static void dispatch(
        Id          notifTypeId,
        String      title,
        String      body,
        Id          targetId,
        Set<String> recipientIds
    ) {
        try {
            Messaging.CustomNotification notif = new Messaging.CustomNotification();
            notif.setNotificationTypeId(notifTypeId);
            notif.setTitle(title);
            notif.setBody(body);
            notif.setTargetId(targetId);
            notif.send(recipientIds);
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR,
                'ApprovalNotificationSender.dispatch FAILED'
                + ' | title=' + title
                + ' | targetId=' + targetId
                + ' | recipients=' + recipientIds
                + ' | error=' + e.getMessage()
                + ' | type=' + e.getTypeName()
            );
        }
    }

    private static String truncate(String value, Integer maxLen) {
        if (String.isBlank(value)) return '';
        return value.length() <= maxLen ? value : value.left(maxLen - 3) + '...';
    }


