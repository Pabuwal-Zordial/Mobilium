/*************************************************************************************
Name                    cls_OpportunityTriggerHandler
Developed By           Kaushik
Purpose              The following are the requirements for the trigger
                        After Update
                            * On a successful update of an opportunity amount,update optyfields
                            * it will pouplate the Fraud Management QC value, Business Assurence QC Values, Business Operation QC value, Revenue Assurence QC value.
                            * Create  Custome Label for the Fraud Management,Business Assurence, Business Operation, Revenue Assurence.
                            Created date            5/11/2020
History

*************************************************************************************/
public class cls_OpportunityTriggerHandler {
	public static boolean runOnce = true;
	public static boolean alreadyRun = false;

	/*************************************************************************************
    Method Name          updateOpportunityValues
    Developed By            Kaushik
    Purpose              * To Update Opportunity Fields based on the Products selected
    Created date            5/10/2020
    Parameters            OpportunityId
    Output type         NA
    History
   *************************************************************************************/

	public static void updateOpportunityValues(List<Opportunity> optyList, map<Id, Opportunity> oldMap) {
		map<Id, Decimal> opportunityMap = new Map<Id, Decimal>();
		map<Id, Decimal> FMopportunityMap = new Map<Id, Decimal>();
		map<Id, Decimal> BAopportunityMap = new Map<Id, Decimal>();
		map<Id, Decimal> BOopportunityMap = new Map<Id, Decimal>();
		map<Id, Decimal> REopportunityMap = new Map<Id, Decimal>();
		map<Id, Id> optyIdMap = new Map<Id, Id>();
		map<Id, Decimal> RiskAMCopportunityMap = new Map<Id, Decimal>();

		List<Opportunity> opportunityLst = new List<Opportunity>();
		Set<Id> opportunitySet = new Set<Id>();
		for (Opportunity opp : optyList) {
			if (opp.Amount != null && opp.SBQQ__PrimaryQuote__c != null && (oldMap.get(opp.Id).Amount != opp.Amount || cls_OpportunityTriggerHandler.runOnce)) {
				opportunitySet.add(opp.Id);
				cls_OpportunityTriggerHandler.runOnce = false;
			}

			if (opp.Hardware_delivery_involved__c == 'Yes') {
				opp.Opportunity_Approval_Type__c = 'Non-Standard';

				// Add 3rd party HW/SW, HW (proprietary) to Non Standard Conditions
				if (String.isBlank(opp.Non_Standard_Conditions__c)) {
					opp.Non_Standard_Conditions__c = 'Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)';
				} else if (!opp.Non_Standard_Conditions__c?.contains('Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)')) {
					opp.Non_Standard_Conditions__c += ';Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)';
				}
            }else{
                system.debug('debug here ' + opp.Non_Standard_Conditions__c);
                if (opp.Non_Standard_Conditions__c != null && opp.Non_Standard_Conditions__c.contains(';Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)')) {
					opp.Non_Standard_Conditions__c = opp.Non_Standard_Conditions__c?.remove(';Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)');
                }else if (opp.Non_Standard_Conditions__c != null && opp.Non_Standard_Conditions__c?.contains('Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)')){
                    opp.Non_Standard_Conditions__c = opp.Non_Standard_Conditions__c?.remove('Commercial or COTS 3rd party HW/SW” STANDARD Vendor LIST in PS template + Margin is < 25% (like Oracle, HP, Dell, Couchbase, Posgress, Cloudera, Dialogic, etc.)');
                }
            }
		}
		if (opportunitySet.size() > 0) {
			for (OpportunityLineItem oppLin : [SELECT Business_Line__c, id, OpportunityId, Total_Price_Selected_Currency__c, Product2.Risk_BU_Product_Line__c, Product2.Family, ProductCode FROM OpportunityLineItem WHERE opportunityId IN :opportunitySet AND (Product2.Family = 'Software License' OR Product2.Family = 'Annual Maintenance (AMC)' OR Product2.Risk_BU_Product_Line__c != NULL)]) {
				Decimal oppPrice = 0;
				if (oppLin.Business_Line__c == 'Risk') {
					if (oppLin.Product2.Family == 'Software License') {
						oppPrice = (opportunityMap.containsKey(oppLin.OpportunityId)) ? opportunityMap.get(oppLin.OpportunityId) + oppLin.Total_Price_Selected_Currency__c : 0 + oppLin.Total_Price_Selected_Currency__c;
						opportunityMap.put(oppLin.OpportunityId, oppPrice);
					}
					if (oppLin.Product2.Family == 'Annual Maintenance (AMC)' && oppLin.ProductCode == 'MNT-RSK-PRM') {
						oppPrice = (RiskAMCopportunityMap.containsKey(oppLin.OpportunityId)) ? RiskAMCopportunityMap.get(oppLin.OpportunityId) + oppLin.Total_Price_Selected_Currency__c : 0 + oppLin.Total_Price_Selected_Currency__c;
						RiskAMCopportunityMap.put(oppLin.OpportunityId, oppPrice);
					}
					if (oppLin.Product2.Risk_BU_Product_Line__c == System.Label.Fraud_Management) {
						oppPrice = (FMopportunityMap.containsKey(oppLin.OpportunityId)) ? FMopportunityMap.get(oppLin.OpportunityId) + oppLin.Total_Price_Selected_Currency__c : 0 + oppLin.Total_Price_Selected_Currency__c;
						FMopportunityMap.put(oppLin.OpportunityId, oppPrice);
					}
					if (oppLin.Product2.Risk_BU_Product_Line__c == System.Label.Revenue_Assurance) {
						oppPrice = (REopportunityMap.containsKey(oppLin.OpportunityId)) ? REopportunityMap.get(oppLin.OpportunityId) + oppLin.Total_Price_Selected_Currency__c : 0 + oppLin.Total_Price_Selected_Currency__c;
						REopportunityMap.put(oppLin.OpportunityId, oppPrice);
					}
					if (oppLin.Product2.Risk_BU_Product_Line__c == System.Label.Business_Assurance) {
						oppPrice = (BAopportunityMap.containsKey(oppLin.OpportunityId)) ? BAopportunityMap.get(oppLin.OpportunityId) + oppLin.Total_Price_Selected_Currency__c : 0 + oppLin.Total_Price_Selected_Currency__c;
						BAopportunityMap.put(oppLin.OpportunityId, oppPrice);
					}
					if (oppLin.Product2.Risk_BU_Product_Line__c == System.Label.Business_Operations) {
						oppPrice = (BOopportunityMap.containsKey(oppLin.OpportunityId)) ? BOopportunityMap.get(oppLin.OpportunityId) + oppLin.Total_Price_Selected_Currency__c : 0 + oppLin.Total_Price_Selected_Currency__c;
						BOopportunityMap.put(oppLin.OpportunityId, oppPrice);
					}
				} else {
					opportunityMap.put(oppLin.OpportunityId, oppPrice = (opportunityMap.containsKey(oppLin.OpportunityId)) ? opportunityMap.get(oppLin.OpportunityId) : 0);
					FMopportunityMap.put(oppLin.OpportunityId, (FMopportunityMap.containsKey(oppLin.OpportunityId)) ? FMopportunityMap.get(oppLin.OpportunityId) : 0);
					REopportunityMap.put(oppLin.OpportunityId, (REopportunityMap.containsKey(oppLin.OpportunityId)) ? REopportunityMap.get(oppLin.OpportunityId) : 0);
					BAopportunityMap.put(oppLin.OpportunityId, (BAopportunityMap.containsKey(oppLin.OpportunityId)) ? BAopportunityMap.get(oppLin.OpportunityId) : 0);
					BOopportunityMap.put(oppLin.OpportunityId, (BOopportunityMap.containsKey(oppLin.OpportunityId)) ? BOopportunityMap.get(oppLin.OpportunityId) : 0);
					RiskAMCopportunityMap.put(oppLin.OpportunityId, (RiskAMCopportunityMap.containsKey(oppLin.OpportunityId)) ? RiskAMCopportunityMap.get(oppLin.OpportunityId) : 0);
				}
				optyIdMap.put(oppLin.OpportunityId, oppLin.OpportunityId);
			}
			for (Opportunity opp : optyList) {
				if (opp.Amount != null && opp.SBQQ__PrimaryQuote__c != null) {
					opp.Software_License_Booking_for_Risk_QC__c = opportunityMap.containsKey(opp.Id) ? opportunityMap.get(opp.Id) : 0;
					opp.Business_Assurance_Booking_Value_QC__c = BAopportunityMap.containsKey(opp.Id) ? BAopportunityMap.get(opp.Id) : 0;
					opp.Business_Operations_Booking_Value_QC__c = BOopportunityMap.containsKey(opp.Id) ? BOopportunityMap.get(opp.Id) : 0;
					opp.Fraud_Management_Booking_Value_QC__c = FMopportunityMap.containsKey(opp.Id) ? FMopportunityMap.get(opp.Id) : 0;
					opp.Revenue_Assurance_Booking_Value_QC__c = REopportunityMap.containsKey(opp.Id) ? REopportunityMap.get(opp.Id) : 0;
					opp.AMC_Booking_Value_for_Risk__c = RiskAMCopportunityMap.containsKey(opp.Id) ? RiskAMCopportunityMap.get(opp.Id) : 0;
					if (opp.Software_License_Booking_for_Risk_QC__c != null && opp.Software_License_Booking_for_Risk_QC__c <> 0) {
						opp.Software_License_Booking_for_Risk_QC__c = (opp.Software_License_Booking_for_Risk_QC__c + opp.AMC_Booking_Value_for_Risk__c);
					}
				}
			}
		} //End of if
	}
    
