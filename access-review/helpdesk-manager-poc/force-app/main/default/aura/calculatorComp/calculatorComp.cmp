<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
	<aura:attribute name="Number1" type="Integer" default="10"> </aura:attribute> 
    <aura:attribute name="Number2" type="Integer" default="20"> </aura:attribute>
      <aura:attribute name="Result" type="Decimal" default="0.0"> </aura:attribute>
      
    <lightning:input type="Integer" name="no1" value="{!v.Number1}" label="Enter a 1st number"> </lightning:input>
    <lightning:input type="Integer" name="no2" value="{!v.Number2}" label="Enter a 2nd number"> </lightning:input>
 <lightning:buttongroup>
     <lightning:button variant="brand" label="Add" title="Add" onclick="{! c.add }" />
     <lightning:button variant="brand" label="Sub" title="Sub" onclick="{! c.sub }" />
     <lightning:button variant="brand" label="Mul" title="Mul" onclick="{! c.mul }" />
     <lightning:button variant="brand" label="Div" title="Div" onclick="{! c.div }" />
     </lightning:buttongroup>
    
   Result is {!v.Result}
                  
</aura:component>