<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Adhaar_rule</fullName>
    <active>true</active>
    <errorConditionFormula>OR(NOT(REGEX( Adhaar_Number__c , &quot;[1-9]*&quot;)),  LEN(Adhaar_Number__c)   &lt;&gt; 12 )</errorConditionFormula>
    <errorDisplayField>Adhaar_Number__c</errorDisplayField>
    <errorMessage>Adhaar should be number of twelve digit</errorMessage>
</ValidationRule>
