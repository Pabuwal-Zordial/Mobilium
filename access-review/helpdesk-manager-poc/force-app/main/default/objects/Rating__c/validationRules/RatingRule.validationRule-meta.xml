<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RatingRule</fullName>
    <active>true</active>
    <errorConditionFormula>Rating_no__c  &lt; 0  || Rating_no__c  &gt; 6</errorConditionFormula>
    <errorMessage>Rating must be in range from 1 to 5</errorMessage>
</ValidationRule>
