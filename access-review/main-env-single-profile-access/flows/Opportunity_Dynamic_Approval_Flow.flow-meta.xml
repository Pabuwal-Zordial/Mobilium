        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>opportunityId</name>
            <value>
                <elementReference>recordId</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>DynamicApprovalEngine</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>ApexStatus</assignToReference>
