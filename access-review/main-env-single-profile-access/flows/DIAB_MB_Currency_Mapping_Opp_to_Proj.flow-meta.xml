<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Quote_Currency_Exist</name>
        <label>Quote Currency Exist?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pse__Opportunity__r.Currency_Table__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Currency</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>1. Copy Opportunity Quote Currency(QC) in Project CurrencyIsoCode
2. Populate Company on Project with Companies(Foundation) record whose entity number matches Opportunity Entity Number</description>
    <environments>Default</environments>
    <interviewLabel>DIAB_MB_Currency_Mapping_Opp_to_Proj {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DIAB_MB_Currency_Mapping_Opp_to_Proj</label>
    <processMetadataValues>
