<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Regional_Delivery_Approver</name>
        <label>Add Regional Delivery Approver</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varApproverIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Regional_Delivery_Members.UserOrGroupId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Regional_Delivery_Members</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Amount_Check</name>
        <label>Amount Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Delivery_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Less_Thank_100K</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Amount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delivery_Check</targetReference>
            </connector>
            <label>Less Thank 100K</label>
        </rules>
        <rules>
            <name>Greater_than_or_Equal_to_100k</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Amount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delivery_Check</targetReference>
            </connector>
            <label>Greater than or Equal to 100k</label>
        </rules>
    </decisions>
    <decisions>
        <name>Delivery_Amount_Check</name>
        <label>Delivery Amount Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Less_Than_100K</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Amount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Regional_Delivery_Group</targetReference>
            </connector>
            <label>Less Than 100K</label>
        </rules>
    </decisions>
    <decisions>
        <name>Delivery_Check</name>
        <label>Delivery Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Delivery_equals_to_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Delivery_Involved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delivery_Amount_Check</targetReference>
            </connector>
            <label>If Delivery equals to Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Renewals_or_Non_Renewals</name>
        <label>Renewals or Non Renewals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Amount_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Renewals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Cross_sell1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewals</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Amount_Check</targetReference>
            </connector>
            <label>Renewals</label>
        </rules>
        <rules>
            <name>Non_Renewals</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Cross_sell1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New Logo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Cross_sell1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Upsell</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Getting_Opportunity_Records.Cross_sell1__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cross sell</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Amount_Check</targetReference>
            </connector>
            <label>Non Renewals</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Stage 4 Approval Process Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stage 4 Approval Process Flow</label>
    <loops>
        <name>Loop_Regional_Delivery_Members</name>
        <label>Loop Regional Delivery Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Regional_Delivery_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Regional_Delivery_Approver</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Regional_Delivery_Group</name>
        <label>Get Regional Delivery Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Regional_Delivery_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Regional_Delivery_Head_Fsys</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Regional_Delivery_Members</name>
        <label>Get Regional Delivery Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Regional_Delivery_Members</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>GroupId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Regional_Delivery_Group.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GroupMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Getting_Opportunity_Records</name>
        <label>Getting Opportunity Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Renewals_or_Non_Renewals</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Getting_Opportunity_Records</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varApproverIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
