<!--
/*************************************************************************************
Name                    lb_loeCalculator
Developed By            West Monroe Partners
Purpose                 The component will handle the following:
						 - display the generic 4 common products for loe calculation
						 - displays the products from the quote line items - provided the checkbox is false in product
						 - validates the hours entered and split up and stores the values in the quote line items

Created date              5/15/2017
History
*************************************************************************************
VERSION  	AUTHOR 	DATE      		DETAIL
1.0			SS		5/15/2017		Refer component header
2.0 		SS      6/7/2017        Changes as per Sanjit and Amol's request
									Refer to "Change - 2.0 in comments"
*************************************************************************************/
-->
<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId"
				controller="clsLBHandler_loeCalculator"
>
	<aura:handler event="aura:systemError" action="{!c.showSystemError}"/>
	<!-- #1 Creating the list of quote line attribute to save -->
	<aura:attribute name="quoteLines"
		          type="SBQQ__QuoteLine__c[]" />
	<!-- #2 Creating the list of string that serve as column headers -->
	<aura:attribute name="columnHeaders"
		          type="String[]" />
	<!-- #3 Creating the list of common products from custom metadata types -->
	<aura:attribute name="commonProducts"
		          type="LoE_Calculator__mdt[]" />
	<!-- #4 Creating the primary quote -->
	<aura:attribute name="primaryQuote"
		          type="SBQQ__Quote__c" />
    <!-- #5 we need a placeholder for each row, stores the overall value -->
   	<aura:attribute name="totalPMRowSum"
   		          type="Integer" />
	<aura:attribute name="totalSoftInstallRow"
				type="Integer" />
	<aura:attribute name="totalSoftInstallAdditionalRow"
				type="Integer" />
	<aura:attribute name="totalTestBedRow"
				type="Integer" />
	<aura:attribute name="totalGeoRow"
				type="Integer" />
	<aura:attribute name="totalDBRow"
				type="Integer" />
	<aura:attribute name="total3PInstRow"
				type="Integer" />
	<aura:attribute name="totalMiscRow"
				type="Integer" />
   <!-- #6 we need a placeholder for each column and overall total-->
   	<aura:attribute name="totalGenHours"
   		          type="Integer" />
	<aura:attribute name="totalSSHours"
	   		          type="Integer" />
	<aura:attribute name="totalDeployHours"
	   		          type="Integer" />
	<aura:attribute name="totalIntegHours"
	   		          type="Integer" />
	<aura:attribute name="totalIntTestHours"
	   		          type="Integer" />
	<aura:attribute name="totalUATHours"
	   		          type="Integer" />
	<aura:attribute name="totalDocHours"
	   		          type="Integer" />
	<aura:attribute name="totalProdHours"
	   		          type="Integer" />
	<aura:attribute name="totalHours"
	   		          type="Integer" />
  	<aura:attribute name="deploymentHeaderTotalHours"
  		          type="Integer" />
  	<aura:attribute name="allowSave"
  		          type="Boolean" />
  	<aura:attribute name="instructionText"
  					type="string" />
	<aura:attribute name="showAccordian"
				type="Boolean" />
	<aura:attribute name="showSave"
				type="Boolean" />
	<!-- Handler to call the init function  -->
	<aura:handler name="init"
		          value="{!this}"
			      action="{!c.mtd_dataLoaderForQuote}" />

	<!--  checking if any quote lines -->
	<aura:if isTrue="{!(v.quoteLines.length > 0)}">
		<div class="slds-table--edit_container slds-is-relative" id="loeDetails" >
			<h3 class="slds-section-title--divider"> DETAILED LEVEL OF EFFORT (LoE) CHART {IN PERSON DAYS}</h3>
			<!--  Displaying the quote lines in a table -->

			<table class="slds-table slds-table--edit slds-table--bordered slds-table--fixed-layout slds-no-cell-focus slds-no-row-hover"
					 role="grid"
					 style="width:100%">
	   			<thead>
					<!-- Shows the header for the category -->
					<tr class="slds-line-height--reset">
						<td width="15%"><th></th></td>
						<td width="10%"><th>Instructions</th></td>
						<!-- Iterates through the list of column headers -->
						<aura:iteration items="{!v.columnHeaders}"
							          var="headerValue">
							<td width="9%">
			        				<th scope="col" style="white-space: pre-line;">{!headerValue}</th>
							</td>
						</aura:iteration>
						<td width="3%">
									<th scope="col" style="white-space: pre-line;">Totals</th>
						</td>
					</tr>
				</thead>
				<tbody>

					<!--  First row Kick Off generic product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="kickOffGeneralProduct"
											value="{!v.commonProducts[0].MasterLabel}"
								/>
						</td>
						<td>

										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Kick_Off_Instructions__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[0].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Kick_Off_Instructions__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[0].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.KickOff_General_Hours__c}"
												change="{!c.updateTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<!-- disabled ="{!NOT(v.commonProducts[0].isGeneralType__c)}" -->
						<!--  rest of the phases will be disabled -->
						<td>
								<ui:inputNumber maxlength="3"
												value=""
												disabled="true"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value=""
												disabled="true"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value=""
												disabled="true"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value=""
												disabled="true"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value=""
												disabled="true"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value=""
												disabled="true"
								/>
						</td>
						<td>
								<ui:outputText aura:id="kickOffGeneralTotal"
											value="{!v.primaryQuote.KickOff_General_Hours__c}"
								/>
						</td>
					</tr>

					<!--  Software Installation Main Phase product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="softInstallGeneralProduct"
											value="{!v.commonProducts[1].MasterLabel}"
								/>
						</td>
						<td>
										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Software_Installation_Main_Phase_Ins__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[1].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Software_Installation_Main_Phase_Ins__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[1].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_General__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_SS__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_Deploy__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_Intg__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_InTest__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_UAT__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Main_Phase_Doc__c}"
												change="{!c.updateSoftInstTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:outputText aura:id="sftInstallGeneralTotal"
											value="{!v.totalSoftInstallRow}"
								/>
						</td>
					</tr>
					<!--  Software Installation Additional Phase product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="softInstallAdditionalGeneralProduct"
											value="{!v.commonProducts[2].MasterLabel}"
								/>
						</td>
						<td>
										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Software_Installation_Add_Phases_Insts__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[2].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Software_Installation_Add_Phases_Insts__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[2].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Addi_Phases_Gen__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Add_Phases_SS__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Add_Phases_Dply__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Add_Phases_Intg__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Add_Phases_InTest__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Add_Phases_UAT__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Software_Installation_Add_Phases_Doc__c}"
												change="{!c.updateSoftInstAddTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:outputText aura:id="sftInstallAddGeneralTotal"
											value="{!v.totalSoftInstallAdditionalRow}"
								/>
						</td>
					</tr>
					<!--  Test Bed deployment product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="TestBedProduct"
											value="{!v.commonProducts[3].MasterLabel}"
								/>
						</td>
						<td>
										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Test_Bed_deployment_Inst__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[3].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Test_Bed_deployment_Inst__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[3].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_General__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_SS__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_Dply__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_Intg__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_InTest__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_UAT__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Test_Bed_deployment_Doc__c}"
												change="{!c.updateTestBedTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:outputText aura:id="totalTestBedTotal"
											value="{!v.totalTestBedRow}"
								/>
						</td>
					</tr>
					<!--  Geo Redundant deployment product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="geoProduct"
											value="{!v.commonProducts[4].MasterLabel}"
								/>
						</td>
						<td>
										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Geo_Redundant_deployment_Inst__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[4].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Geo_Redundant_deployment_Inst__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[4].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_General__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_SS__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_Dply__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_Intg__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_InTest__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_UAT__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Geo_Redundant_deployment_Doc__c}"
												change="{!c.updateGeoTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:outputText aura:id="totalgeoTotal"
											value="{!v.totalGeoRow}"
								/>
						</td>
					</tr>
					<!--  Database deployment product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="databaseDeploymentProduct"
											value="{!v.commonProducts[5].MasterLabel}"
								/>
						</td>
						<td>
										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Database_deployment_Insts__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[5].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Database_deployment_Insts__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[5].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Database_deployment_General__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Database_deployment_SS__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Database_deployment_Dply__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Database_deployment_Intg__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Database_deployment_InTest__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Database_deployment_UAT__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
