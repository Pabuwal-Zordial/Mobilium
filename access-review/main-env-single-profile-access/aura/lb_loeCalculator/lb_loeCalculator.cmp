												value="{!v.primaryQuote.Database_deployment_Doc__c}"
												change="{!c.updateDBTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:outputText aura:id="totalDBTotal"
											value="{!v.totalDBRow}"
								/>
						</td>
					</tr>
					<!--  3P installation product -->
					<tr class="slds-line-height--reset">
						<td>
								<ui:outputText aura:id="3PInstallProduct"
											value="{!v.commonProducts[6].MasterLabel}"
								/>
						</td>
						<td>
										<aura:if isTrue="{!and(v.showSave,empty(v.primaryQuote.Third_Party_installation_Inst__c))}">
											<button class="slds-button slds-button--neutral" onclick="{!c.showModal}" id="{!v.commonProducts[6].MasterLabel}">
											Add
											</button>
										</aura:if>
										<aura:if isTrue="{!not(empty(v.primaryQuote.Third_Party_installation_Inst__c))}">
											<button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[6].MasterLabel}">
											View
											</button>
										</aura:if>

						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Third_Party_installation_Gen__c}"
												change="{!c.update3PInsTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Third_Party_installation_SS__c}"
												change="{!c.update3PInsTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Third_Party_installation_Dply__c}"
												change="{!c.update3PInsTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Third_Party_installation_Intg__c}"
												change="{!c.update3PInsTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
								<ui:inputNumber maxlength="3"
												value="{!v.primaryQuote.Third_Party_installation_inTest__c}"
												change="{!c.update3PInsTotals}"
												disabled="{!!v.showSave}"
								/>
						</td>
						<td>
