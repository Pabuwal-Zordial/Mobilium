		                                    </aura:if>
		                                    <aura:if isTrue="{!not(empty(v.primaryQuote.Training_Instructions__c))}">
		                                        <button class="slds-button slds-button--brand" onclick="{!c.showModal}" id="{!v.commonProducts[9].MasterLabel}">
		                                        View
