			<div id="loeTotals">
				<h3 class="slds-section-title--divider">LoE TYPE BREAKOUT</h3>
				<div width="100%">
					<table>
						<tr>
							<td>
							<!--  Displaying the quote lines in a table -->
							<table class="slds-table slds-table--edit slds-table--bordered slds-table--fixed-layout slds-no-cell-focus slds-no-row-hover"
									 role="grid"
									 style="width:100%">
					   			<thead>
									<!-- Shows the header for the category -->
									<tr class="slds-line-height--reset">
										<td width="40%">
											<th>LoE Table</th>
										</td>
										<td width="15%">
						        				<th scope="col" style="white-space: pre-line;">Total</th>
										</td>
										<td width="15%">
						        				<th scope="col" style="white-space: pre-line;">IDC Off Site</th>
										</td>
										<td width="15%">
						        				<th scope="col" style="white-space: pre-line;">IDC Onsite</th>
										</td>
										<td width="15%">
						        				<th scope="col" style="white-space: pre-line;">RoW/ Partner</th>
										</td>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td> DEPLOYMENT </td>
										<td class="{!v.deploymentHeaderTotalHours == (v.primaryQuote.Deployment_OffSite__c+ v.primaryQuote.Deployment_OnSite__c + v.primaryQuote.Deployment_RoW__c) ? 'equalTo100' : 'not100'}">
											 <ui:outputNumber value="{!v.deploymentHeaderTotalHours}" />
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Deployment_OffSite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Deployment_OnSite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Deployment_RoW__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
									</tr>
									<tr>
										<td> LAUNCH SUPPORT </td>
										<td class="{!v.primaryQuote.Post_production_Launch_spprt_General_Hrs__c == (v.primaryQuote.Support_OffSite__c + v.primaryQuote.Support_OnSite__c + v.primaryQuote.Support_Row__c) ? 'equalTo100' : 'not100'}">
											 <ui:outputNumber value="{!v.primaryQuote.Post_production_Launch_spprt_General_Hrs__c}" />
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Support_OffSite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Support_OnSite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Support_Row__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
									</tr>
									<tr>
										<td> TRAINING </td>
										<td class="{!v.primaryQuote.Training_General_Hours__c == (v.primaryQuote.Training_OffSite__c + v.primaryQuote.Training_OnSite__c + v.primaryQuote.Training_Row__c) ? 'equalTo100' : 'not100'}">
											 <ui:outputNumber value="{!v.primaryQuote.Training_General_Hours__c}" />
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Training_OffSite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Training_OnSite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.Training_Row__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
									</tr>
									<tr>
										<td> PROJECT MANAGEMENT </td>
										<td class="{!v.totalPMRowSum == (v.primaryQuote.PM_Offsite__c+ v.primaryQuote.PM_Onsite__c + v.primaryQuote.PM_Row__c) ? 'equalTo100' : 'not100'}">
											 <ui:outputNumber value="{!v.totalPMRowSum}"
											 />
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.PM_Offsite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.PM_Onsite__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
										<td>
											<ui:inputNumber value="{!v.primaryQuote.PM_Row__c}"
															maxlength="3"
															change="{!c.validateHeaderHours}"
															disabled="{!!v.showSave}"/>
										</td>
									</tr>
									<!--  final total row -->
									<tr>
										<td> TOTALS </td>
										<td>
									   		<ui:outputNumber value="{!v.totalHours}" />
									    </td>
									   	<td>
									   		<ui:outputNumber value="{!v.primaryQuote.Deployment_OffSite__c + v.primaryQuote.Support_OffSite__c + v.primaryQuote.Training_OffSite__c + v.primaryQuote.PM_Offsite__c}" />
									    </td>
									    <td>
									   		<ui:outputNumber value="{!v.primaryQuote.Deployment_OnSite__c + v.primaryQuote.Support_OnSite__c + v.primaryQuote.Training_OnSite__c + v.primaryQuote.PM_Onsite__c}" />
									    </td>
									    <td>
									   		<ui:outputNumber value="{!v.primaryQuote.Deployment_RoW__c + v.primaryQuote.Support_Row__c + v.primaryQuote.Training_Row__c + v.primaryQuote.PM_Row__c}" />
									    </td>
									</tr>
								</tbody>
							</table>
						</td>
						<td width="50%" style="vertical-align:bottom;text-align:right">
							<aura:if isTrue="{!and(v.allowSave,v.showSave)}">
									<ui:button class="slds-button--brand" label="Save" press="{!c.saveLoE}"/>
							</aura:if>
						</td>
					</tr>
					</table>
				</div>
			</div>
		</div>
		<br/>
		<div class="test-id__section slds-section full forcePageBlockSection forcePageBlockSectionView" id="accordianDiv">
			<h3 class="slds-section__title  test-id__section-header-container">
				<ui:button class="slds-button test-id__section-header-button slds-section__title-action" aura:id="buttonClicker" press="{!c.toggleAccordian}">
					<aura:if isTrue="{!v.showAccordian}">
						<lightning:icon iconName="utility:chevrondown" size="x-small" alternativeText="Indicates approval"/>
					</aura:if>
					<aura:if isTrue="{!!v.showAccordian}">
						<lightning:icon iconName="utility:chevronright" size="x-small" alternativeText="Indicates approval"/>
					</aura:if>
					<span class="test-id__section-header-title slds-truncate">   Products from Quote for reference</span>
				</ui:button>
			</h3>
			<!-- accodian contents -->
			<div class="test-id__section-content slds-section__content section__content">
				<table class="slds-table slds-table--edit slds-table--bordered slds-table--fixed-layout slds-no-cell-focus slds-no-row-hover"
						 role="grid"
						 style="width:100%">
		   			<thead>
						<!-- Shows the header for the category -->
						<tr>
							<th> Product Code </th>
							<th> Estimated in LoE </th>
						</tr>
					</thead>
					<tbody>
						<aura:iteration items="{!v.quoteLines}" var="qLines">
							<tr>
								<td>
									<ui:outputText value="{!qLines.SBQQ__ProductCode__c}" />
								</td>
								<td>
									<ui:inputCheckbox value="{!qLines.LoE_Accounted__c}" disabled="{!!v.showSave}"/>
								</td>
							</tr>
						</aura:iteration>
					</tbody>
				</table>
			</div>
		</div>
	</aura:if>
	<!--  Ensuring that error message is thrown if not found -->
	<aura:if isTrue="{!(v.quoteLines.length == 0)}">
		No quote line(s) found
	</aura:if>

	<!--  Modal code -->
	<div aria-hidden="false" id="newClientSectionId" role="dialog" class="slds-modal slds-modal--large slds-fade-in-open" style="display:none;background-color:lightgrey">
	   <div class="slds-modal__container">
		     <div class="slds-modal__header">

			      <h2 class="slds-text-heading--medium" >
			      	<span id="header43"> </span>
			      </h2>
		     </div>
		     <div class="slds-modal__content slds-p-around--medium">
			      <div>
			         	<!--  instructions -->
					<aura:if isTrue="{!v.showSave}">
			         		<ui:inputTextArea value="{!v.instructionText}" rows="5"/>
					</aura:if>
					<aura:if isTrue="{!!v.showSave}">
			         		<ui:outputTextArea value="{!v.instructionText}" />
					</aura:if>
			      </div>
			      <br/>
				<aura:if isTrue="{!v.showSave}">
			      	<button class="slds-button slds-button--success" onclick="{!c.saveInstruction}">Save</button>
				</aura:if>
			      <button class="slds-button slds-button--brand" onclick="{!c.hideModal}">Close</button>
		      </div>
		</div>
 	</div>


</aura:component>