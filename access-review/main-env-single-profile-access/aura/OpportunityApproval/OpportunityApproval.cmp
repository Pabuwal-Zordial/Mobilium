<aura:component implements="force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global" Controller="cls_OpportunityApprovalHandler">
  <aura:attribute name="recordId" type="Id" />
  <aura:attribute name="recordError" type="String"/>   
    
<aura:handler name="init" value="{!this}" action="{!c.doInit}" />
 <div class="slds-align_absolute-center" style="height: 5rem;">
       <aura:unescapedHtml value="{!v.recordError}"/>
    </div>
</aura:component>