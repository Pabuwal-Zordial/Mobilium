<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Acronym_Max_Size</fullName>
    <active>true</active>
    <errorConditionFormula>LEN(Name) &lt;&gt; 6</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Customer acronym must have 6 characters.</errorMessage>
</ValidationRule>
