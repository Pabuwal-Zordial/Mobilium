<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Create_HW_purchase_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>ISNEW() &amp;&amp; Opportunity__r.HW_purchase_approval_status__c!=&apos;Approved&apos; 
 &amp;&amp; Opportunity__r.HW_purchase_approval_status__c!=&apos;Rejected&apos; &amp;&amp; Opportunity__r.HW_purchase_approval_status__c!=&apos;Cancelled&apos; &amp;&amp; Opportunity__r.Number_of_Hw_request__c &gt;0</errorConditionFormula>
    <errorMessage>Can not create new Hardware purchase Request unless the previous is Approved/Rejected/Cancelled</errorMessage>
</ValidationRule>
