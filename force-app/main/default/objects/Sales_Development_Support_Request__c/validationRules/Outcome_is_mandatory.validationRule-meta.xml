<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Outcome_is_mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Request_Status__c  , &quot;closed&quot;) &amp;&amp;  ISPICKVAL(Outcome__c , &quot;&quot;)</errorConditionFormula>
    <errorDisplayField>Outcome__c</errorDisplayField>
    <errorMessage>Outcome is mandatory when Request Status is changed to Closed</errorMessage>
</ValidationRule>
