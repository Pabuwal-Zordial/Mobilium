@isTest
private class WhiteSpaceAnalysisTest {

    @testSetup
    static void setupTestData() {
        // Create demo offerings
        List<Offering__c> offerings = new List<Offering__c>{
            new Offering__c(Name = 'Network Analytics', Offering_Code__c = 'TEST-OFF-01', Product_Family__c = 'Network', Sort_Order__c = 1, Active__c = true),
            new Offering__c(Name = 'Security', Offering_Code__c = 'TEST-OFF-02', Product_Family__c = 'Security', Sort_Order__c = 2, Active__c = true),
            new Offering__c(Name = 'Inactive Offering', Offering_Code__c = 'TEST-OFF-INACTIVE', Active__c = false)
        };
        insert offerings;

        // Create test Account
        Account testAcc = new Account(Name = 'Apex Test Telecom Corp');
        insert testAcc;
    }

    @isTest
    static void testAccountPlanAndAssessmentGeneration() {
        Account testAcc = [SELECT Id FROM Account WHERE Name = 'Apex Test Telecom Corp' LIMIT 1];

        Test.startTest();
        // Insert Account Plan for FY2027
        Account_Plan__c plan = new Account_Plan__c(
            Account__c = testAcc.Id,
            Fiscal_Year__c = 'FY2027',
            Status__c = 'Active'
        );
        insert plan;
        Test.stopTest();

        // Verify Plan Key generation
        Account_Plan__c insertedPlan = [
            SELECT Id, Plan_Key__c, Total_Customer_Spend__c, Our_Revenue__c, Total_White_Space__c, Share_of_Wallet__c
            FROM Account_Plan__c
            WHERE Id = :plan.Id
        ];
        System.assertEquals(testAcc.Id + '_FY2027', insertedPlan.Plan_Key__c, 'Plan Key should match AccountId_FiscalYear');

        // Verify White Space Assessments auto-generated by Flow 1 (only for active offerings)
        List<White_Space_Assessment__c> assessments = [
            SELECT Id, Account_Plan__c, Offering__c, Offering__r.Active__c,
                   Our_Spending__c, Competitor_Spending__c, Internal_Spending__c, Unknown_Spending__c,
                   Total_Customer_Spending__c, White_Space_Value__c, Share_of_Wallet__c, Status__c
            FROM White_Space_Assessment__c
            WHERE Account_Plan__c = :plan.Id
        ];

        // Should have created 2 assessments (since 1 is inactive)
        System.assert(assessments.size() >= 2, 'Should have generated assessments for active offerings');
        for (White_Space_Assessment__c wsa : assessments) {
            System.assertEquals(0, wsa.Our_Spending__c, 'Default Our Spending should be 0');
            System.assertEquals(0, wsa.Total_Customer_Spending__c, 'Default Total Customer Spending should be 0');
            System.assertEquals('White Space', wsa.Status__c, 'Default Status should be White Space');
        }
    }

    @isTest
    static void testSpendingCalculationsAndRollups() {
        Account testAcc = [SELECT Id FROM Account WHERE Name = 'Apex Test Telecom Corp' LIMIT 1];
        Account_Plan__c plan = new Account_Plan__c(
            Account__c = testAcc.Id,
            Fiscal_Year__c = 'FY2028',
            Status__c = 'Active'
        );
        insert plan;

        List<White_Space_Assessment__c> assessments = [
            SELECT Id, Offering__r.Offering_Code__c, Our_Spending__c, Competitor_Spending__c, Internal_Spending__c, Unknown_Spending__c
            FROM White_Space_Assessment__c
            WHERE Account_Plan__c = :plan.Id
        ];

        System.assert(!assessments.isEmpty(), 'Assessments should exist');

        // Update spending values on first assessment
        White_Space_Assessment__c wsa = assessments[0];
        wsa.Our_Spending__c = 200000;
        wsa.Competitor_Spending__c = 300000;
        wsa.Internal_Spending__c = 50000;
        wsa.Unknown_Spending__c = 50000;

        Test.startTest();
        update wsa;
        Test.stopTest();

        // Verify formula values on assessment
        White_Space_Assessment__c updatedWsa = [
            SELECT Id, Our_Spending__c, Competitor_Spending__c, Internal_Spending__c, Unknown_Spending__c,
                   Total_Customer_Spending__c, White_Space_Value__c, Share_of_Wallet__c
            FROM White_Space_Assessment__c
            WHERE Id = :wsa.Id
        ];

        // Total: 200k + 300k + 50k + 50k = 600,000
        System.assertEquals(600000, updatedWsa.Total_Customer_Spending__c, 'Total Spend calculation mismatch');
        // White Space: 300k + 50k + 50k = 400,000
        System.assertEquals(400000, updatedWsa.White_Space_Value__c, 'White Space Value calculation mismatch');
        // Share of wallet: 200k / 600k = 33.33%
        System.assertEquals(33.33, updatedWsa.Share_of_Wallet__c.setScale(2), 'Share of wallet percentage mismatch');

        // Verify rollups on parent Account Plan
        Account_Plan__c updatedPlan = [
            SELECT Id, Total_Customer_Spend__c, Our_Revenue__c, Total_White_Space__c, Share_of_Wallet__c
            FROM Account_Plan__c
            WHERE Id = :plan.Id
        ];
        System.assertEquals(600000, updatedPlan.Total_Customer_Spend__c, 'Account Plan Total Customer Spend rollup mismatch');
        System.assertEquals(200000, updatedPlan.Our_Revenue__c, 'Account Plan Our Revenue rollup mismatch');
        System.assertEquals(400000, updatedPlan.Total_White_Space__c, 'Account Plan Total White Space rollup mismatch');
        System.assertEquals(33.33, updatedPlan.Share_of_Wallet__c.setScale(2), 'Account Plan Share of wallet rollup mismatch');
    }

    @isTest
    static void testOpportunityPipelineRollupFlow() {
        Account testAcc = [SELECT Id FROM Account WHERE Name = 'Apex Test Telecom Corp' LIMIT 1];
        Account_Plan__c plan = new Account_Plan__c(
            Account__c = testAcc.Id,
            Fiscal_Year__c = 'FY2029',
            Status__c = 'Active'
        );
        insert plan;

        Test.startTest();
        // Insert Open Opportunity
        Opportunity openOpp = new Opportunity(
            Name = 'Test Open Deal',
            AccountId = testAcc.Id,
            Account_Plan__c = plan.Id,
            StageName = 'Prospecting',
            CloseDate = Date.today().addDays(30),
            Amount = 150000
        );
        insert openOpp;

        // Insert Closed Won Opportunity
        Opportunity wonOpp = new Opportunity(
            Name = 'Test Won Deal',
            AccountId = testAcc.Id,
            Account_Plan__c = plan.Id,
            StageName = 'Closed Won',
            CloseDate = Date.today(),
            Amount = 250000
        );
        insert wonOpp;
        Test.stopTest();

        Account_Plan__c updatedPlan = [
            SELECT Id, Open_Pipeline_Value__c, Closed_Won_Revenue__c
            FROM Account_Plan__c
            WHERE Id = :plan.Id
        ];

        System.assertEquals(150000, updatedPlan.Open_Pipeline_Value__c, 'Open Pipeline Value should reflect open opportunities');
        System.assertEquals(250000, updatedPlan.Closed_Won_Revenue__c, 'Closed Won Revenue should reflect won opportunities');
    }
}
